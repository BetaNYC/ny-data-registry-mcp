  "non_topical": {
    "about": "Labels with no topic are checked against these patterns, in order, so the crosswalk can say what they are (a place, a year, a file format, a publishing office). They never give a topic.",
    "year": "^(19|20)\\d\\d( \\d+)?$|^fy ?\\d+|^\\d{4} \\d{4}$",
    "place": "^(new york( state| city)?|nys|nyc|ny|bronx|brooklyn|manhattan|queens|staten island|long island|westchester|suffolk|nassau|albany|buffalo|rochester|syracuse|monroe|erie|tioga|wayne|livingston|yates|columbia|dutchess|putnam|sullivan|otsego|oswego|ontario|steuben|warren|genesee|cattaraugus|cortland|tompkins|ithaca|adirondack park|hudson valley|capital region|state|federal|local|regional|statewide|citywide|county$|.* county|city of .*|town of .*|village of .*)$",
    "format": "^(gis|map|mapserver|featureserver|feature service|feature layer|map service|web map|xform|survey123|survey123 form|shapefile|kml|csv|api|dataset|data|layer|hosted|hub|interactive map|new interactive map|app|application|dashboard|story map|storymap|arcgis|esri|vector tile|tile layer|raster|image service|geojson|table|spreadsheet|pdf|report|open data report|internal content|external content|draft|current|historic|monthly|annual|weekly|daily|quarterly|archive|archived|test|sample|public|public facing|portal|nyc bigapps|cityworks|analysis|studies|study|reference|other|services?)$",
