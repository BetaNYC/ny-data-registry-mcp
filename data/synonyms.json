{
  "_readme": "Small synonym table for keyword search (find_sources and search_datasets). A query term on the left also searches every term on the right. A two-word key (\"tax lot\") matches only when those two words appear together, in order, in the query. Keep it short and civic: this is not a thesaurus.",
  "terms": {
    "property": ["parcel", "parcels", "tax lot", "bbl", "assessment", "real property"],
    "parcel": ["parcels", "tax parcel", "tax lot", "tax map", "real property", "assessment"],
    "parcels": ["parcel", "tax parcel", "tax lot", "tax map", "real property"],
    "tax lot": ["parcel", "parcels", "tax parcel", "tax map"],
    "tax lots": ["parcel", "parcels", "tax parcel", "tax map"],
    "rat": ["rodent", "rodents"],
    "rats": ["rodent", "rodents"],
    "rodent": ["rodents", "rat"],
    "lead": ["lead service line", "lead pipe", "lead service"],
    "pipes": ["service line", "water main"],
    "crime": ["arrests", "incidents", "public safety"],
    "zoning": ["zoning district", "land use"],
    "budget": ["spending", "appropriations", "expense"],
    "transit": ["bus", "subway", "gtfs", "rail"],
    "health": ["hospital", "disease", "medicaid"],
    "schools": ["school", "education"],
    "311": ["service requests", "complaints"],
    "elections": ["election", "voter"],
    "trees": ["tree", "street tree", "forestry"],
    "housing": ["affordable housing", "rent", "hpd"],
    "bike": ["bicycle", "cycling"],
    "bicycle": ["bike"],
    "covid": ["coronavirus"],
    "coronavirus": ["covid"],
    "tax map": ["parcel", "tax lot", "tax parcel"],
    "assessment roll": ["assessment", "real property", "parcel"],
    "voting": ["election", "elections", "polling place"],
    "garbage": ["trash", "refuse", "sanitation", "dsny"],
    "broadband": ["internet", "wi-fi", "wifi"],
    "police": ["nypd", "precinct"]
  }
}
